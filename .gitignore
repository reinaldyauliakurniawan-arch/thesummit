/node_modules
/public/build
/public/hot
/public/storage
/storage/*.key
/storage/logs/*.log
/vendor
.env
.env.backup
.env.production
.phpunit.result.cache
Homestead.json
Homestead.yaml
auth.json
npm-debug.log
